{
  "id": "urn:ngsi-ld:Subscription:apetit-weather",
  "type": "Subscription",
  "description": "Daily weather for the Apetit yield backend",
  "entities": [
    {
      "type": "WeatherObserved"
    }
  ],
  "watchedAttributes": [
    "dateObserved"
  ],
  "notification": {
    "format": "normalized",
    "endpoint": {
      "uri": "http://BACKEND_HOST:8600/notify",
      "accept": "application/json"
    }
  }
}